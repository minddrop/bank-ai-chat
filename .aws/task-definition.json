{
  "family": "bank-ai-backend-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::123456789012:role/BankAiEcsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::123456789012:role/BankAiEcsTaskRole",
  "containerDefinitions": [
    {
      "name": "bank-ai-container",
      "image": "123456789012.dkr.ecr.ap-northeast-1.amazonaws.com/bank-ai-chat-app:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8000,
          "hostPort": 8000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "AWS_DEFAULT_REGION",
          "value": "ap-northeast-1"
        },
        {
          "name": "BEDROCK_MODEL_ID",
          "value": "amazon.nova-lite-v1:0"
        },
        {
          "name": "FISC_AUDIT_LOG_BUCKET",
          "value": "japan-bank-ai-audit-log-ap-northeast-1"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/bank-ai-backend-service",
          "awslogs-region": "ap-northeast-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
